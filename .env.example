# Required Google Maps keys. Setup and quotas: docs/google-maps.md.
# Browser key: website restrictions + Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: Places API (New) + Routes API. Never prefix with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=
# Optional production JavaScript map ID. The prototype uses DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional Gemini. Keep its project separate if using a free tier without billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional dedicated signing key; otherwise a configured server key is used.
# PLACE_SIGNING_SECRET=generate_a_random_server_secret
# APP_PUBLIC_URL=https://your-project.vercel.app

# Optional accounts. Never expose service-role credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PASSWORD_RECOVERY_ENABLED=true
