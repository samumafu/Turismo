# Optional. Without a key, OSM search and rule-based planning work.
# Create a FREE TIER project without billing at https://aistudio.google.com/apikey
# Never prefix the key with NEXT_PUBLIC_. Never commit .env.local.
# Copy this file to .env.local next to package.json, then restart npm run dev.
# Verify one real Gemini request with: npm run check:gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Free public Overpass providers. No account or billing required.
OVERPASS_API_URL=https://overpass.private.coffee/api/interpreter
# Optional second Overpass instance; only for network failures and 5xx.
OVERPASS_FALLBACK_URL=disabled
# Alternative OSM index for interactive searches when Overpass is unavailable.
# Less coverage than Overpass; no regional-cuisine inference, no manual POI data.
PHOTON_FALLBACK_ENABLED=true
# Public URL for identifying this app to providers. Vercel supplies VERCEL_URL.
# APP_PUBLIC_URL=https://your-project.vercel.app

# Optional public tile URL. Must be an HTTPS provider whose policy you accept.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Supabase project URL and publishable key (safe to expose; RLS is required).
# Leave empty to use the application without an account.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep false until Brevo SMTP and the Supabase recovery email template are ready.
NEXT_PUBLIC_PASSWORD_RECOVERY_ENABLED=false
